#{
    build => #{
        rust => #{
            supported => true,
            sdk => #{rtems_major => 5, c_target => <<"arm-rtems5">>,
                     panic => <<"unwind">>, newlib_errno => <<"__errno">>,
                     c_enum_min_bits => 32, std_variant => <<"generic">>},
            bsp => "imx7",
            cflags => ["-march=armv7-a", "-mfpu=neon", "-mfloat-abi=hard"],
            cargo_opts => [
                {target, "armv7-rtems-eabihf"},
                {rustflags, ["-C", "target-cpu=cortex-a7", "-C", "relocation-model=static", "-C", "panic=unwind"]}
            ],
            nm => "arm-rtems5-nm"
        },
        xcomp_conf => "xcomp/erl-xcomp-arm-rtems5.conf"
    }
}.
