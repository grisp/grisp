+void BeamModuleAssembler::emit_i_get_map_elements(const ArgLabel &Fail,
+                                                  const ArgSource &Src,
+                                                  const ArgWord &Size,
+                                                  const Span<const ArgVal> &args) {
+    ASSERT(Size.get() == args.size());
