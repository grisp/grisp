+void BeamModuleAssembler::emit_is_reference(const ArgLabel &Fail,
+                                            const ArgSource &Src) {
+    auto src = load_source(Src, TMP);
+
+    emit_is_boxed(resolve_beam_label(Fail, dispUnknown), Src, src.reg);
