new file mode 100644
index 0000000000..9c2e9a6a21
--- /dev/null
+++ b/erts/emulator/beam/jit/arm/32/process_main.cpp
@@ -0,0 +1,344 @@
+/*
+ * %CopyrightBegin%
+ *
+ * SPDX-License-Identifier: Apache-2.0
