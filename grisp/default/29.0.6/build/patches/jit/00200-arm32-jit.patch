+Error query_features(const BaseInst& inst, const Operand_* operands, size_t op_count, CpuFeatures* out) noexcept {
+  // TODO: AArch32 tooling.
+  Support::maybe_unused(inst, operands, op_count, out);
+
+  return Error::kOk;
+}
