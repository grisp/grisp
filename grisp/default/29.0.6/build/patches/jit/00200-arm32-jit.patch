+
+    /* ARG3 is already set by the caller */
+    a.mov(ARG2, ARG4);
+    a.mov(ARG4, ARG1);
+    a.mov(ARG1, c_p);
+    runtime_call<void (*)(Process *, Uint, Eterm, Eterm), beam_jit_bs_construct_fail_info>();
+
+    emit_leave_runtime<Update::eHeapAlloc>();
+
+    mov_imm(ARG4, 0);
+    a.ldr(ARG2, TMP_MEM5q);
+    a.b(labels[raise_exception_shared]);
+}
