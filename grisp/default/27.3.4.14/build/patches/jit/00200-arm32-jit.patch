+
+//! \addtogroup asmjit_a32
+//! \{
+
+//! AArch32 assembler implementation.
+class ASMJIT_VIRTAPI Assembler
+  : public BaseAssembler,
+    public EmitterExplicitT<Assembler> {
+
+public:
+  typedef BaseAssembler Base;
+
+  //! \name Construction & Destruction
+  //! \{
