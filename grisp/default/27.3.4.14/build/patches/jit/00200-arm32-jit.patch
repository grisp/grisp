+            emit_branch_if_not_value(ARG1, resolve_beam_label(Fail, dispUnknown));
+        } else {
+            fragment_call(ga->get_update_map_exact_body_shared());
+        }
+    }
+
+    mov_arg(Dst, ARG1);
+}
