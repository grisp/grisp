+// a32::Assembler - Construction & Destruction
+// ===========================================
+
+Assembler::Assembler(CodeHolder* code) noexcept : BaseAssembler() {
+  _archMask = (uint64_t(1) << uint32_t(Arch::kARM  )) |
+              (uint64_t(1) << uint32_t(Arch::kThumb)) ;
+  if (code)
+    code->attach(this);
+}
