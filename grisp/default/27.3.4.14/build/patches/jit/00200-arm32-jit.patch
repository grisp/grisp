+//! \addtogroup asmjit_a32
+//! \{
+
+//! AArch32 emitter.
+//!
+//! NOTE: This class cannot be instantiated, you can only cast to it and use it as emitter that emits to either
+//! \ref Assembler, \ref Builder, or \ref Compiler (use with caution with \ref Compiler as it expects virtual
+//! registers to be used).
+template<typename This>
+struct EmitterExplicitT {
+  //! \cond
+
+  // These two are unfortunately reported by the sanitizer. We know what we do, however, the sanitizer doesn't.
+  // I have tried to use reinterpret_cast instead, but that would generate bad code when compiled by MSC.
+  ASMJIT_ATTRIBUTE_NO_SANITIZE_UNDEF ASMJIT_INLINE_NODEBUG This* _emitter() noexcept { return static_cast<This*>(this); }
+  ASMJIT_ATTRIBUTE_NO_SANITIZE_UNDEF ASMJIT_INLINE_NODEBUG const This* _emitter() const noexcept { return static_cast<const This*>(this); }
+
+  using CC = CondCode;
+
+  enum : uint32_t {
+    kCCShift = Support::ConstCTZ<uint32_t(InstIdParts::kARM_Cond)>::value,
+    kDT1Shift = Support::ConstCTZ<uint32_t(InstIdParts::kA32_DT)>::value,
+    kDT2Shift = Support::ConstCTZ<uint32_t(InstIdParts::kA32_DT2)>::value
+  };
+
+  enum : uint32_t {
+    kDT1_8    = uint32_t(DataType::kU8  ) << kDT1Shift,
+    kDT1_16   = uint32_t(DataType::kU16 ) << kDT1Shift,
+    kDT1_32   = uint32_t(DataType::kU32 ) << kDT1Shift,
+    kDT1_64   = uint32_t(DataType::kU64 ) << kDT1Shift,
+
+    kDT1_S8   = uint32_t(DataType::kS8  ) << kDT1Shift,
+    kDT1_S16  = uint32_t(DataType::kS16 ) << kDT1Shift,
+    kDT1_S32  = uint32_t(DataType::kS32 ) << kDT1Shift,
+    kDT1_S64  = uint32_t(DataType::kS64 ) << kDT1Shift,
+    kDT1_U8   = uint32_t(DataType::kU8  ) << kDT1Shift,
+    kDT1_U16  = uint32_t(DataType::kU16 ) << kDT1Shift,
+    kDT1_U32  = uint32_t(DataType::kU32 ) << kDT1Shift,
+    kDT1_U64  = uint32_t(DataType::kU64 ) << kDT1Shift,
+    kDT1_F16  = uint32_t(DataType::kF16 ) << kDT1Shift,
+    kDT1_F32  = uint32_t(DataType::kF32 ) << kDT1Shift,
+    kDT1_F64  = uint32_t(DataType::kF64 ) << kDT1Shift,
+    kDT1_P8   = uint32_t(DataType::kP8  ) << kDT1Shift,
+    kDT1_P64  = uint32_t(DataType::kP64 ) << kDT1Shift,
+    kDT1_BF16 = uint32_t(DataType::kBF16) << kDT1Shift,
+
+    kDT2_S8   = uint32_t(DataType::kS8  ) << kDT2Shift,
+    kDT2_S16  = uint32_t(DataType::kS16 ) << kDT2Shift,
