+void BeamModuleAssembler::emit_try_end(const ArgYRegister &CatchTag) {
+    a.ldr(TMP, arm::Mem(c_p, offsetof(Process, catches)));
+    a.sub(TMP, TMP, imm(1));
+    a.str(TMP, arm::Mem(c_p, offsetof(Process, catches)));
+    mov_imm(TMP, NIL);
+    a.str(TMP, getArgRef(CatchTag));
+}
