+    emit_leave_runtime();
+    emit_leave_runtime_frame();
+
+    emit_branch_if_not_value(ARG1, fail);
+    mov_imm(TMP, 0);
+    a.tst(TMP, TMP); /* Z = 1 on success */
+    a.bx(a32::lr);
+
+    a.bind(fail);
+    mov_imm(TMP, 1);
