+swap2 R1 R2 R3 | swap R3Other R4 |
+  equal(R3, R3Other) =>
+    swap3 R1 R2 R3 R4
+swap2 R1 R2 R3 | swap R4 R3Other |
+  equal(R3, R3Other) =>
+    swap3 R1 R2 R3 R4
+
+swap3 R1 R2 R3 R4 | swap R4Other R5 |
+  equal(R4, R4Other) =>
+    swap4 R1 R2 R3 R4 R5
+swap3 R1 R2 R3 R4 | swap R5 R4Other |
+  equal(R4, R4Other) =>
+    swap4 R1 R2 R3 R4 R5
