+static ASMJIT_FORCE_INLINE uint32_t ZoneVector_growCapacity(uint32_t current, uint32_t growMinimum, uint32_t sizeOfT) noexcept {
+  static constexpr size_t kGrowThreshold = Globals::kGrowThreshold;
