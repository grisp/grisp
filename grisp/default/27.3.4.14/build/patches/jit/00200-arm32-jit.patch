+        a32::Gp boxed_ptr = emit_ptr_val(TMP, src.reg);
+        a.ldr(VAR, emit_boxed_val(boxed_ptr));
+        a.and_(VAR, VAR, imm(_TAG_HEADER_MASK));
+        a.cmp(VAR, imm(_TAG_HEADER_EXTERNAL_PID));
